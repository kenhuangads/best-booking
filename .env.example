# ───────────── 基本 ─────────────
# 對外網址（通知裡的「開啟追蹤清單」按鈕會用到；LINE 按鈕需 https）。部署在 Vercel 可留空，會自動偵測。
APP_URL=http://localhost:3000
# 設定後，整個 App 需要輸入密碼（HTTP Basic Auth，帳號可任意填）。部署到公網強烈建議設定。
APP_PASSWORD=

# ───────────── 資料庫 ─────────────
# 本機 / Docker：SQLite 檔案路徑（相對於專案根目錄）
DATABASE_PATH=data/best-booking.db
# Vercel 等無伺服器環境：改用 Turso（免費，https://turso.tech）。設定後優先於 SQLite。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ───────────── 資料來源 ─────────────
# auto = 有 SERPAPI_KEY 就用 Google 即時價格，否則用示範資料；也可強制 demo / serpapi / amadeus
FLIGHT_PROVIDER=auto
HOTEL_PROVIDER=auto
# SerpApi（Google 航班 / Google 飯店即時價格）：https://serpapi.com 註冊後在 Dashboard 取得 API Key
SERPAPI_KEY=
# Travelpayouts（Aviasales 過去 48 小時的搜尋快取）：免費、額度大，當追蹤用的價格雷達與價格日曆
# https://www.travelpayouts.com 註冊後，在個人資料頁的「API token」複製
TRAVELPAYOUTS_TOKEN=
# 快取依市場分，台灣出發沒有專屬市場，依序嘗試（預設 us,ru）
TRAVELPAYOUTS_MARKETS=us,ru
# 有加入聯盟行銷才需要：訂票連結會帶上你的 marker
TRAVELPAYOUTS_MARKER=
# Amadeus Self-Service 已於 2026/7/17 關閉，僅供已有 Amadeus 企業版帳號者使用
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# ───────────── LINE 官方帳號（Messaging API） ─────────────
# https://developers.line.biz/console/ → Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 官方帳號的 Basic ID（含 @），用來產生「加入好友」連結
LINE_BOT_BASIC_ID=

# ───────────── Telegram Bot ─────────────
# 找 @BotFather 建立機器人
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# true = 伺服器主動輪詢（本機開發免公開網址）；Vercel 會自動改用 webhook（設定頁有一鍵設定按鈕）
TELEGRAM_POLLING=true
# webhook 驗證用的任意字串（建議設定）
TELEGRAM_WEBHOOK_SECRET=

# ───────────── 排程 ─────────────
# 內建排程（常駐伺服器每 CHECK_TICK_SECONDS 秒檢查一次到期的追蹤；Vercel 會自動停用）
SCHEDULER_ENABLED=true
CHECK_TICK_SECONDS=60
# 外部 cron 呼叫 GET /api/cron/check?key=... 用的密鑰（Vercel Cron 會自動帶入）
CRON_SECRET=
