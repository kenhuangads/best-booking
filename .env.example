# ───────────── 基本 ─────────────
# 對外網址（通知裡的「開啟追蹤清單」按鈕會用到；LINE 按鈕需 https）。部署在 Vercel 可留空，會自動偵測。
APP_URL=http://localhost:3000
# 設定後，整個 App 需要輸入密碼（HTTP Basic Auth，帳號可任意填）。部署到公網強烈建議設定。
APP_PASSWORD=

# ───────────── 資料庫 ─────────────
# 本機 / Docker：SQLite 檔案路徑（相對於專案根目錄）
DATABASE_PATH=data/best-booking.db
# Vercel 等無伺服器環境：改用 Turso（免費，https://turso.tech）。設定後優先於 SQLite。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ───────────── 資料來源 ─────────────
# auto = 有 Amadeus 金鑰就用 Amadeus，否則用示範資料；也可以強制 demo / amadeus
FLIGHT_PROVIDER=auto
HOTEL_PROVIDER=auto
# Amadeus for Developers（免費）：https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test（免費測試環境，資料有限）或 production
AMADEUS_ENV=test

# ───────────── LINE 官方帳號（Messaging API） ─────────────
# https://developers.line.biz/console/ → Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 官方帳號的 Basic ID（含 @），用來產生「加入好友」連結
LINE_BOT_BASIC_ID=

# ───────────── Telegram Bot ─────────────
# 找 @BotFather 建立機器人
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# true = 伺服器主動輪詢（本機開發免公開網址）；Vercel 會自動改用 webhook（設定頁有一鍵設定按鈕）
TELEGRAM_POLLING=true
# webhook 驗證用的任意字串（建議設定）
TELEGRAM_WEBHOOK_SECRET=

# ───────────── 排程 ─────────────
# 內建排程（常駐伺服器每 CHECK_TICK_SECONDS 秒檢查一次到期的追蹤；Vercel 會自動停用）
SCHEDULER_ENABLED=true
CHECK_TICK_SECONDS=60
# 外部 cron 呼叫 GET /api/cron/check?key=... 用的密鑰（Vercel Cron 會自動帶入）
CRON_SECRET=
